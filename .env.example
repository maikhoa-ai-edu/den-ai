# Tên các biến môi trường cần khai báo trên Vercel (Settings > Environment Variables).
# Tệp này chỉ ghi TÊN biến. Không bao giờ ghi giá trị thật vào kho mã.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys > Secret key (hoặc service_role)
# Đây là khóa toàn quyền: chỉ dán vào Vercel, không gửi cho ai, không dán vào mã.
SUPABASE_SECRET_KEY=

# --- Bản 0.2: đăng nhập khu nhóm ---
# Mật khẩu của 3 tài khoản, mỗi cái ít nhất 8 ký tự, ba cái khác nhau.
MAT_KHAU_GV=
MAT_KHAU_HS1=
MAT_KHAU_HS2=

# Chuỗi ngẫu nhiên ít nhất 16 ký tự, dùng để ký "vé" đăng nhập. Đổi chuỗi này thì mọi người phải đăng nhập lại.
BI_MAT_PHIEN=
